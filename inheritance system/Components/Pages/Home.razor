        <a href="/register" class="btn-solid">Register</a>
    </div>
</nav>

<!-- HERO -->
<section class="hero">
    <div class="hero-ornament">
        <div class="ornament-line"></div>
        <div class="ornament-diamond"></div>
        <div class="ornament-line right"></div>
    </div>

    <div class="hero-badge">
        ⚖ Pakistan's First Digital Inheritance Management System
    </div>

    <h1>
        Secure Your Family's<br>
        <span>Property &amp; Inheritance</span>
    </h1>

    <p class="hero-subtitle">
        MirasPro digitizes the entire inheritance process — from property registration and heir management
        to Faraid calculation, dispute resolution, and legal document storage. All in one secure platform.
    </p>

    <div class="hero-cta">
        <a href="/register" class="btn-hero-primary">Start Managing Free →</a>
        <a href="#how-it-works" class="btn-hero-outline">See How It Works</a>
    </div>

    <div class="hero-stats">
        <div class="stat-item">
            <span class="stat-number">1,200+</span>
            <span class="stat-label">Properties Registered</span>
        </div>
        <div class="stat-item">
            <span class="stat-number">3,800+</span>
            <span class="stat-label">Heirs Managed</span>
        </div>
        <div class="stat-item">
            <span class="stat-number">98%</span>
            <span class="stat-label">Dispute Resolution Rate</span>
        </div>
        <div class="stat-item">
            <span class="stat-number">Faraid</span>
            <span class="stat-label">Sharia-Compliant Calculations</span>
        </div>
    </div>
</section>

<!-- SECTION DIVIDER -->
<div class="divider">
    <div class="divider-line"></div>
    <span class="divider-text">What is MirasPro?</span>
    <div class="divider-line"></div>
</div>

<!-- ABOUT / INTRO -->
<section id="about">
    <div class="intro-grid">
        <!-- Visual mock panel -->
        <div class="intro-visual">
            <div class="visual-card">
                <div class="visual-icon">🏠</div>
                <div>
                    <div class="visual-card-title">House — DHA Phase 5, Lahore</div>
                    <div class="visual-card-sub">3 heirs · PKR 1.2 Crore</div>
                </div>
                <span class="visual-badge badge-active">Active</span>
            </div>
            <div class="visual-card">
                <div class="visual-icon">🏢</div>
                <div>
                    <div class="visual-card-title">Commercial Plaza — Gulberg III</div>
                    <div class="visual-card-sub">5 heirs · PKR 4.5 Crore</div>
                </div>
                <span class="visual-badge badge-pending">Dispute</span>
            </div>
            <div class="visual-card">
                <div class="visual-icon">🌾</div>
                <div>
                    <div class="visual-card-title">Agricultural Land — Sargodha</div>
                    <div class="visual-card-sub">2 heirs · PKR 80 Lakh</div>
                </div>
                <span class="visual-badge badge-resolved">Transferred</span>
            </div>
            <div class="visual-card">
                <div class="visual-icon">📊</div>
                <div>
                    <div class="visual-card-title">Faraid shares calculated</div>
                    <div class="visual-card-sub">Wife: 1/8 · Sons: 2x · Daughters: 1x</div>
                </div>
                <span class="visual-badge badge-active">Done</span>
            </div>
        </div>

        <!-- Text -->
        <div>
            <p class="section-label">About the system</p>
            <h2 class="section-title">A complete digital solution for inheritance management</h2>
            <p class="section-body">
                In Pakistan, inheritance disputes are among the most common legal conflicts — taking years
                and significant resources to resolve. MirasPro was built to solve this.
            </p>
            <br>
            <p class="section-body">
                We provide families and administrators with a secure digital platform
                to register properties, assign heirs, calculate Islamic inheritance shares (Faraid) under
                the Muslim Family Laws Ordinance 1961, manage disputes, and store legal documents — all in one place.
            </p>
            <br>
            <p class="section-body" style="font-style: italic; color: var(--green-mid); border-left: 3px solid var(--green-border); padding-left: 1rem;">
                "Protecting your family's rights begins with proper documentation and transparent distribution."
            </p>
        </div>
    </div>
</section>

<!-- FEATURES -->
<section id="features" class="features-section">
    <div class="features-inner">
        <div class="features-header">
            <p class="section-label">What you can do</p>
            <h2 class="section-title">Everything you need, in one platform</h2>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">🏠</div>
                <div class="feature-title">Property Registry</div>
                <div class="feature-desc">Register residential, commercial, agricultural, and digital assets with complete ownership records.</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon">👨‍👩‍👧‍👦</div>
                <div class="feature-title">Heir Management</div>
                <div class="feature-desc">Add all legal heirs with their relation and share percentage. Keep family records organized and up to date.</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon">⚖</div>
                <div class="feature-title">Faraid Calculator</div>
                <div class="feature-desc">Automatically calculate Sharia-compliant inheritance shares based on the Muslim Family Laws Ordinance 1961.</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🗂</div>
                <div class="feature-title">Document Vault</div>
                <div class="feature-desc">Securely upload and store title deeds, wills, CNIC copies, court orders, and all legal documents.</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🤝</div>
                <div class="feature-title">Dispute Resolution</div>
                <div class="feature-desc">File, track, and resolve inheritance disputes with a structured review process managed by administrators.</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🔄</div>
                <div class="feature-title">Ownership Transfer</div>
                <div class="feature-desc">Process gift deeds and sale transfers digitally with full audit trails and approval workflows.</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📜</div>
                <div class="feature-title">Ownership History</div>
                <div class="feature-desc">View complete chain of ownership for any property — every transfer, every date, every owner recorded.</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🛡</div>
                <div class="feature-title">Role-Based Access</div>
                <div class="feature-desc">Two roles only — <strong>User</strong> and <strong>Admin</strong> — with separate dashboards and secure access control.</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📊</div>
                <div class="feature-title">Reports & Analytics</div>
                <div class="feature-desc">Generate detailed reports on properties, cases, disputes, and transfers for legal and administrative use.</div>
            </div>
        </div>
    </div>
</section>

<!-- HOW IT WORKS -->
<section id="how-it-works" class="steps-section">
    <div class="steps-inner">
        <div class="steps-header">
            <p class="section-label">Simple process</p>
            <h2 class="section-title">How MirasPro works</h2>
        </div>
        <div class="steps-grid">
            <div class="step-card">
                <div class="step-number">1</div>
                <div class="step-title">Create your account</div>
                <div class="step-desc">Register as a <strong>User</strong> or <strong>Administrator</strong> (with security key).</div>
            </div>
            <div class="step-card">
                <div class="step-number">2</div>
                <div class="step-title">Register your properties</div>
                <div class="step-desc">Add all your properties with location, type, estimated value, and supporting documents.</div>
            </div>
            <div class="step-card">
                <div class="step-number">3</div>
                <div class="step-title">Add heirs &amp; calculate shares</div>
                <div class="step-desc">Enter your legal heirs and let MirasPro automatically calculate Faraid shares.</div>
            </div>
            <div class="step-card">
                <div class="step-number">4</div>
                <div class="step-title">Manage &amp; transfer</div>
                <div class="step-desc">Handle disputes, approve transfers, and keep a permanent record of all ownership changes.</div>
            </div>
        </div>
    </div>
</section>

<!-- WHO IS IT FOR -->
<section class="audience-section">
    <p class="section-label">Who is it for?</p>
    <h2 class="section-title">Built for everyone involved in inheritance</h2>
    <div class="audience-grid" style="grid-template-columns: repeat(2, 1fr); max-width: 800px; margin-left: auto; margin-right: auto;">
        <div class="audience-card">
            <span class="audience-icon">👤</span>
            <div class="audience-title">User</div>
            <div class="audience-desc">Register properties, add heirs, upload FRC &amp; documents, calculate Faraid, and submit dispute/case applications for admin review.</div>
        </div>
        <div class="audience-card">
            <span class="audience-icon">🛡</span>
            <div class="audience-title">Administrator</div>
            <div class="audience-desc">All platform governance plus former legal duties: verify FRC, review &amp; decide on cases and disputes, manage users and properties, and control the security key.</div>
        </div>
    </div>
</section>

<!-- FARAID SECTION -->
<section id="faraid" class="faraid-section">
    <div class="faraid-inner">
        <div class="faraid-badge">Islamic Inheritance Law</div>
        <h2 class="faraid-title">Built on Faraid — the Sharia-Compliant<br>inheritance calculation system</h2>
        <p class="faraid-desc">
            MirasPro follows the Muslim Family Laws Ordinance 1961 of Pakistan to calculate inheritance shares
            automatically. Enter your family structure and the system does the rest — accurately and transparently.
        </p>
        <div class="faraid-shares">
            <div class="share-pill">
                <div class="share-relation">Wife (with children)</div>
                <div class="share-amount">1/8</div>
            </div>
            <div class="share-pill">
                <div class="share-relation">Wife (no children)</div>
                <div class="share-amount">1/4</div>
            </div>
            <div class="share-pill">
                <div class="share-relation">Son</div>
                <div class="share-amount">2x share</div>
            </div>
            <div class="share-pill">
                <div class="share-relation">Daughter</div>
                <div class="share-amount">1x share</div>
            </div>
            <div class="share-pill">
                <div class="share-relation">Mother</div>
                <div class="share-amount">1/6</div>
            </div>
            <div class="share-pill">
                <div class="share-relation">Father</div>
                <div class="share-amount">1/6</div>
            </div>
        </div>
    </div>
</section>

<!-- CALL TO ACTION -->
<section class="cta-section" id="contact">
