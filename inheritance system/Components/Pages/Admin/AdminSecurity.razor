@page "/admin/security"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject SecuritySettingsService SecuritySvc
@inject AdminService AdminSvc
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>Security Settings — Admin</PageTitle>

@if (_ready)
{
    <div class="page-header">
        <div>
            <h1 class="page-title">Security Module</h1>
            <p class="page-sub">Manage the administrator security key used for admin registration and login</p>
        </div>
        <a href="/admin/console" class="btn btn-outline">← Console</a>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="admin-alert-banner" style="margin-bottom:1rem">@_message</div>
    }

    <div class="admin-panel" style="max-width:520px">
        <h3 style="margin:0 0 1rem;font-size:1.1rem;">Change administrator security key</h3>
        <p style="font-size:0.875rem;color:var(--text-secondary);margin-bottom:1.25rem;">
            Users must enter this key when registering as <strong>Administrator</strong> on the main registration page
            and when signing in at <strong>Admin Login</strong>.
        </p>

        <div class="form-group">
            <label class="form-label">Current security key *</label>
            <input type="password" class="form-input" @bind="_currentSecret" />
        </div>
        <div class="form-group">
            <label class="form-label">New security key *</label>
            <input type="password" class="form-input" @bind="_newSecret" />
            <div class="form-hint">Minimum 8 characters</div>
        </div>
        <div class="form-group">
            <label class="form-label">Confirm new security key *</label>
            <input type="password" class="form-input" @bind="_confirmSecret" />
        </div>

        <button class="btn btn-primary" @onclick="Save" disabled="@_saving">
            @(_saving ? "Saving..." : "Update Security Key")
        </button>
    </div>

    <div class="admin-panel" style="max-width:520px;margin-top:1rem;">
        <h3 style="margin:0 0 0.5rem;font-size:1rem;">Default key (first install)</h3>
        <p style="font-size:0.85rem;color:var(--text-muted);margin:0;">
            If you have never changed the key, the initial value is
            <code style="background:#f3f4f6;padding:2px 6px;border-radius:4px;">@AppConstants.DefaultAdminAccessSecret</code>
            stored in <code>AppConstants.cs</code> and seeded into the database on first run.
        </p>
    </div>
}

@code {
    bool _ready;
    bool _saving;
    string _message = "";
    string _currentSecret = "";
    string _newSecret = "";
    string _confirmSecret = "";

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.LoadFromSessionAsync();
        if (!CurrentUser.IsAdmin)
        {
            Nav.NavigateTo("/login/admin", forceLoad: true);
            return;
        }
        await SecuritySvc.GetAdminSecretAsync();
        _ready = true;
    }

    async Task Save()
    {
        _saving = true;
        _message = "";
        var (ok, msg) = await SecuritySvc.UpdateAdminSecretAsync(
            CurrentUser.UserId, _currentSecret, _newSecret, _confirmSecret);
        _message = msg;
        if (ok)
        {
            _currentSecret = _newSecret = _confirmSecret = "";
            await AdminSvc.LogAsync(CurrentUser.UserId, CurrentUser.FullName,
                "SecurityKey_Updated", "SystemSetting", null, "Admin access secret changed.");
        }
        _saving = false;
    }
}
